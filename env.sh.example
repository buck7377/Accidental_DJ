# Copy to env.sh, fill in your own values, then:  source env.sh
# env.sh is gitignored so your secrets never get committed.

# Spotify -- https://developer.spotify.com/dashboard
# The redirect URI must match what you entered in the app settings EXACTLY,
# including the trailing path. Spotify requires an explicit loopback IP here:
# 127.0.0.1 is accepted, the hostname "localhost" is not.
export SPOTIPY_CLIENT_ID=
export SPOTIPY_CLIENT_SECRET=
export SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# GetSongBPM -- https://getsongbpm.com/api (free; the key arrives by email)
export GETSONGBPM_API_KEY=
